<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#09090B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingTop="30dp"
        android:paddingRight="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/brandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_name"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="High Fidelity Audio Player"
            android:textColor="#71717A"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="32dp"
            android:background="#18181B"
            android:padding="70dp"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Carátula del álbum" />

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Sin reproducción"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Selecciona una canción"
            android:textColor="#A1A1AA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/selectAudioButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:text="Seleccionar audio"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="▶"
            android:textSize="25sp"
            android:visibility="visible" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#27272A" />

        <TextView
            android:id="@+id/deviceProfileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Dispositivo: Detectando..."
            android:textColor="#A1A1AA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Salida: Sistema Android"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RIVØ Audio v0.1-dev"
            android:textColor="#52525B"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>